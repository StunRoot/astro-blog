---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="win-window">
      <div class="win-titlebar">
        <div class="win-title-text">
          <span class="win-title-icon"></span>
          {title}StunRootOS
        </div>
        <div class="win-controls">
          <span class="win-btn-sq">_</span>
          <span class="win-btn-sq">&#9633;</span>
          <span class="win-btn-sq">X</span>
        </div>
      </div>
      <div class="win-menubar">
        <span>File</span>
        <span>Edit</span>
        <span>View</span>
        <span>Favorites</span>
        <span>Help</span>
      </div>
      <div class="win-toolbar">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="https://github.com/StunRoot">GitHub</a>
      </div>
      <div class="win-body">
        <slot />
      </div>
      <div class="statusbar">
        <span>StunRoot</span>
        <span>2026</span>
      </div>
    </div>
  </body>
</html>