---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Polt.StunRoot</title>
  </head>
  <body>
    <nav>
      <a href="/">~</a>
      <a href="/blog">blog</a>
      <a href="https://github.com/StunRoot">github</a>
    </nav>
    <main class="wrap">
      <slot />
    </main>
    <footer>
      <span class="prompt"></span> echo "&copy; 2026 Polt.StunRoot"<span class="cursor"></span>
    </footer>
  </body>
</html>